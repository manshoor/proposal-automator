# Production Environment — CHANGE ALL PASSWORDS
PORT=3000
NODE_ENV=production

# Database — USE STRONG CREDENTIALS
POSTGRES_DB=upwork_proposals
POSTGRES_USER=upwork_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DATABASE_URL=postgresql://upwork_app:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/upwork_proposals

# Ports
BACKEND_PORT=3002
DASHBOARD_PORT=3003
DB_PORT=5433

# CORS — restrict to your dashboard URL
CORS_ORIGIN=http://localhost:3003
