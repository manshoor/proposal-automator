{
  "manifest_version": 3,
  "name": "Upwork Proposal Automator",
  "version": "1.1.0",
  "description": "AI-powered Upwork proposals, job feed filters, client vetting, and message copilot",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/jobs/*",
        "https://www.upwork.com/ab/proposals/job/*",
        "https://www.upwork.com/nx/proposals/job/*",
        "https://www.upwork.com/freelance-jobs/apply/*",
        "https://www.upwork.com/nx/find-work/*"
      ],
      "js": [
        "lib/constants.js",
        "lib/storage.js",
        "lib/api.js",
        "content/hidden-instructions.js",
        "content/vetting.js",
        "content/scraper.js",
        "content/autofill.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/nx/find-work/*",
        "https://www.upwork.com/nx/search/*",
        "https://www.upwork.com/ab/find-work/*",
        "https://www.upwork.com/search/jobs/*"
      ],
      "js": [
        "lib/constants.js",
        "lib/storage.js",
        "lib/api.js",
        "content/vetting.js",
        "content/feed-scraper.js",
        "content/job-filter.js",
        "content/feed-ui.js"
      ],
      "css": ["content/feed-ui.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/ab/messages/*",
        "https://www.upwork.com/nx/messages/*",
        "https://www.upwork.com/messages/*",
        "https://www.upwork.com/nx/interviews/*",
        "https://www.upwork.com/ab/interviews/*"
      ],
      "js": [
        "lib/constants.js",
        "lib/storage.js",
        "lib/api.js",
        "content/message-scraper.js",
        "content/message-ui.js",
        "content/outcome-detector.js"
      ],
      "css": ["content/message-ui.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/ab/proposals*",
        "https://www.upwork.com/nx/proposals*",
        "https://www.upwork.com/freelancers/proposals*"
      ],
      "exclude_matches": [
        "https://www.upwork.com/ab/proposals/job/*",
        "https://www.upwork.com/nx/proposals/job/*"
      ],
      "js": [
        "lib/constants.js",
        "lib/storage.js",
        "lib/api.js",
        "content/outcome-detector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
