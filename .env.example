# Server
PORT=3000
NODE_ENV=development

# Database
POSTGRES_DB=upwork_proposals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/upwork_proposals

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password  # uncomment for production

# Encryption (32-byte hex string for AES-256-CBC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ports (host-side mapping)
BACKEND_PORT=3002
DASHBOARD_PORT=3003
DB_PORT=5433

# CORS (set to dashboard URL in production)
CORS_ORIGIN=*
