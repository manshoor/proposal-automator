# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
POSTGRES_DB=upwork_proposals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/upwork_proposals

# Redis
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password  # uncomment for production

# Encryption (32-byte hex string for AES-256-CBC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ports (host-side mapping)
BACKEND_PORT=3002
DASHBOARD_PORT=3003
DB_PORT=5433

# JWT Authentication
JWT_SECRET=change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3004
GRAFANA_ADMIN_PASSWORD=admin

# CORS (set to dashboard URL in production)
CORS_ORIGIN=*
